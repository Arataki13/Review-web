# Supabase Configuration
# Replace these values with your Supabase project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# TMDB Configuration (Bearer Token)
NEXT_PUBLIC_TMDB_TOKEN=your-tmdb-bearer-token-here

# Supabase Admin / Service Role Key (Required for webhook database updates)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Payzy Integration Settings
PAYZY_API_KEY=your_payzy_api_key
PAYZY_MERCHANT_ID=your_payzy_merchant_id
PAYZY_WEBHOOK_SECRET=your_payzy_webhook_secret
